# Copy to .env on the server and chmod 600. Never commit it.
QUALTRICS_BASE_URL=https://YOUR_DATACENTER.qualtrics.com/API/v3
QUALTRICS_API_TOKEN=paste-token-here
QUALTRICS_SURVEY_ID=SV_xxxxxxxxxxxxxxx
ALLOWED_COURSES=["CS 9A","CS 9B","CS 9C","CS 10A","CS 10B","CS 10C","CS 11","CS 61","CS 100","CS 111","CS 141"]
# device_id -> sha256 of that device's token (see README)
DEVICE_TOKEN_HASHES={"ula-pi-01":"sha256-hex-here"}
# true = log events instead of sending them (local development)
DRY_RUN=false
